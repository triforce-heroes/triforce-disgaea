    ],
    [
      "key",
      "ACT_ID_HERO_AXE_SKILL_4",
    ],
    [
      4,
      Buffer [0A 00 00 00],
    ],
    [
      "notes",
      "スキル・主人公_斧4",
    ],
    [
      "languages",
      {
        "en": "Silver Slugger",
        "es": "Bate plateado",
        "fr": "Batteur d’argent",
        "jp": "シルバースラッガー",
        "ko": "실버 슬러거",
        "zh-TW": "白銀強打",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Build up power, then launch a
devastating blow. Rumor has
it, enemies defeated by this
attack can fly for days.",
        "es": "Acumula fuerza al máximo y la
libera. Dicen que es el golpe que
más lejos manda a los enemigos.
",
        "fr": "Accumule l’énergie pour
la libérer sur l’ennemi
et le projeter au loin.
",
        "jp": "力を溜めに溜めて解き放つ
倒した敵が最も吹き飛ぶと
もっぱらの噂
",
        "ko": "힘을 모으고 모아 터뜨린다.
쓰러진 적은 엄청나게
날아간다는 소문이 있다.
",
        "zh-TW": "一口氣釋放不斷積蓄的力量。
聽說被打倒的敵人
會被擊飛得遠遠的。
",
      },
      "5",
      4,
    ],
    [
      420,
      Buffer [01 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF FF FF FF 46 05 00 00 10 00 00 00 64 00 00 00 60 EA 00 00 00 00 00 00 01 00 00 00 00 00 40 40 00 00 40 40 00 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 41 0A D7 23 3C 66 66 66 3F 66 66 66 3F 01 00 00 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 02 00 00 00 01 00 00 00 CD CC 0C 40 CD CC 0C 40 66 66 E6 3F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 C0 40 01 00 00 00 01 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 64 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 00 02 00 00 00 01 00 00 00 01 00 00 00 CD CC 0C 40 CD CC 0C 40 66 66 E6 3F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 27 00 00 00 C9 07 00 00 89 07 00 00 49 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
