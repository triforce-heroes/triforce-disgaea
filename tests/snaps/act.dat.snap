    [
      "languages",
      {
        "en": "Limit Break Blow",
        "es": "Lanza perforadora",
        "fr": "Lancer de lance",
        "jp": "極点突破スピアブロー",
        "ko": "극점 돌파 스피어 블로",
        "zh-TW": "極點突破飛槍",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Strike the butt of your spear
with all your might, sending
it rocketing through enemies
at high speed.",
        "es": "Golpea el regatón con fuerza y
atraviesa al enemigo con lanza.
Técnica suprema de lanza.
",
        "fr": "Transperce l’ennemi avec
la pointe de la lance
jetée avec force.
",
        "jp": "渾身の力で石突をぶん殴り
高速飛翔する槍で敵を貫く
槍術の奥義
",
        "ko": "혼신의 힘으로 창끝을 때려
고속으로 비상하는 창으로
적을 꿰뚫는 창술의 오의.
",
        "zh-TW": "使出渾身解數打擊槍的尖端，
讓高速飛去的槍貫穿敵人。
是槍術的奧義。
",
      },
      "5",
      4,
    ],
