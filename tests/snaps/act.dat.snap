    [
      "languages",
      {
        "en": "Hurricane Slash",
        "es": "Shuriken tornado",
        "fr": "Cyclone tranchant",
        "jp": "竜巻破裏剣",
        "ko": "용권파리검",
        "zh-TW": "龍捲破裏劍",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Slash at your surroundings
while on the move. Use <cmd CMD_UNIT_MOVE_STICK> to
adjust your direction during
the attack.",
        "es": "Avanza soltando cortes a tu
alrededor. Durante el avance,
ajusta la dirección con  <cmd CMD_UNIT_MOVE_STICK>.
",
        "fr": "Tourbillone en découpant tout
sur son passage. Direction
contrôlable avec <cmd CMD_UNIT_MOVE_STICK>.
",
        "jp": "移動しつつ周囲を切り刻む
移動中に<cmd CMD_UNIT_MOVE_STICK>で移動方向を調整
できる
",
        "ko": "이동하며 주위를 베어 낸다.
이동 중 <cmd CMD_UNIT_MOVE_STICK>으로 이동 방향을
조정할 수 있다.
",
        "zh-TW": "邊移動邊斬擊周圍敵人。
移動中可以<cmd CMD_UNIT_MOVE_STICK>
來調整移動方向。
",
      },
