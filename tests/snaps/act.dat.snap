    [
      "languages",
      {
        "en": "Lion's Roar",
        "es": "Onda del león",
        "fr": "Vague rugissante",
        "jp": "獅子王波",
        "ko": "사자왕파",
        "zh-TW": "獅子王波",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Focus your ki and fire it off
in front of you. Use <cmd CMD_UNIT_MOVE_STICK> to
adjust your direction while
firing.",
        "es": "Concentra tu energía y la lanza
al frente. Durante la descarga,
cambia dirección con <cmd CMD_UNIT_MOVE_STICK>.
",
        "fr": "Concentre l’énergie puis
la relâche. Direction
contrôlable avec <cmd CMD_UNIT_MOVE_STICK>.
",
        "jp": "気を集中させて前方に放つ
放出中に<cmd CMD_UNIT_MOVE_STICK>で向きを
変えることができる
",
        "ko": "기를 모아 전방으로 내뿜는다.
방출 중에 <cmd CMD_UNIT_MOVE_STICK>으로 방향을
바꿀 수 있다.
",
        "zh-TW": "集中氣息並朝前方釋放。
釋放途中可用<cmd CMD_UNIT_MOVE_STICK>
來變更方向。
",
      },
      "5",
      4,
    ],
