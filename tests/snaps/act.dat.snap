    [
      "languages",
      {
        "en": "Blade Rush",
        "es": "Corte recto",
        "fr": "Tranche droite",
        "jp": "一文字スラッシュ",
        "ko": "한일자 베기",
        "zh-TW": "一文字斬",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Release the energy gathered in
your sword into a flying
slash. A fundamental sword
technique.",
        "es": "Convierte la energía de la
espada en un corte envainado.
Técnica básica de espada.
",
        "fr": "Transforme l’énergie contenue
dans son épée en
un coup tranchant.
",
        "jp": "剣に込めたエネルギーを
斬撃に換え飛ばす
剣術の基本技
",
        "ko": "검에 담은 에너지를
참격으로 바꿔 날리는
검술의 기본기.
",
        "zh-TW": "將注入劍裡的能量
轉換為斬擊，並將敵人擊飛。
是劍術的基本技能。
",
      },
      "5",
      4,
    ],
    [
