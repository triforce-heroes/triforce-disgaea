    ],
    [
      "languages",
      {
        "en": "Boulder Crush",
        "es": "Romperrocas",
        "fr": "Brise-roche",
        "jp": "岩石砕き",
        "ko": "바위 쪼개기",
        "zh-TW": "巨石砸毀",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Strike the ground with full
force to drive sharp rocks
into the enemy. A fundamental
axe technique.",
        "es": "Golpea el suelo con fuerza
y ataca con rocas que emergen.
Técnica básica de hacha.
",
        "fr": "Frappe le sol de toutes ses
forces pour écraser l’ennemi
avec les rochers soulevés.
",
        "jp": "地面を思い切りぶっ叩き
隆起した岩で敵を攻撃する
斧術の基本技
",
        "ko": "지면을 힘껏 때려 돌출하는
바위로 적을 공격하는
도끼술의 기본기.
",
        "zh-TW": "使出全力打擊地面，
並以隆起的岩石攻擊敵人。
是斧術的基本技能。
",
      },
      "5",
      4,
    ],
    [
      420,
      Buffer [01 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF FF FF FF 04 01 00 00 08 00 00 00 64 00 00 00 BC 34 00 00 00 00 00 00 01 00 00 00 9A 99 99 3F 9A 99 F9 3F 00 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 01 00 00 00 00 00 C0 40 0A D7 23 3C 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 02 00 00 00 01 00 00 00 00 00 40 40 00 00 90 40 00 00 90 40 00 00 00 3F 00 00 80 40 00 00 00 41 00 00 F0 40 00 00 90 40 00 00 90 40 00 00 00 3F 00 00 00 00 00 00 00 00 00 00 80 3F 01 00 00 00 00 01 00 00 00 00 00 C0 41 01 00 00 00 01 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 64 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FD 01 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 00 02 00 00 00 01 00 00 00 01 00 00 00 00 00 40 40 00 00 90 40 00 00 90 40 00 00 00 3F 00 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 24 00 00 00 C6 07 00 00 86 07 00 00 46 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
