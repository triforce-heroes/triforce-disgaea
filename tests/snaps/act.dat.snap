    [
      "notes",
      "スキル・主人公_槍3",
    ],
    [
      "languages",
      {
        "en": "Bamboo Blow",
        "es": "Corte de bambú",
        "fr": "Taillade courbée",
        "jp": "竹子円斬",
        "ko": "빙글빙글 찌르기",
        "zh-TW": "竹子圓斬",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Spin your spear and throw it.
The spear will travel in an
arc, striking every foe in its
path.",
        "es": "Proyecta una lanza giratoria,
se desplaza en un arco y golpea
a los enemigos en su trayectoria.
",
        "fr": "Jette une lance tournoyante
qui décrit une courbe pour
toucher les ennemis présents.
",
        "jp": "回転させた槍をぶん投げる
槍は弧を描くように移動し
軌道上の敵を攻撃する
",
        "ko": "회전시킨 창을 던진다.
창은 호를 그리며 이동하여
궤도상의 적을 공격한다.
",
        "zh-TW": "旋轉槍並將之投出，
使槍以拋物線移動，
並攻擊路徑上的敵人。
",
      },
      "5",
      4,
    ],
    [
      420,
