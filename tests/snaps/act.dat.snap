    [
      "languages",
      {
        "en": "Shadow Twin",
        "es": "Doble posimagen",
        "fr": "Vision double",
        "jp": "ダブル残影陣",
        "ko": "더블 잔영진",
        "zh-TW": "雙重殘影陣",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Create a clone of yourself
that follows you and mimics
your actions for a period of
time.",
        "es": "Invoca una copia de ti mismo.
La copia te sigue un tiempo
y repite tus acciones.
",
        "fr": "Crée deux clones qui suivent
le lanceur temporairement
en reproduisant ses actions.
",
        "jp": "自身の分身体を召喚する
分身体は一定時間追従し、
同じ行動を行う
",
        "ko": "자신의 분신을 소환한다.
분신은 일정 시간 따라다니며
같은 행동을 한다.
",
        "zh-TW": "召喚自己的分身體，
使分身體在特定時間內跟隨自己，
並做出相同的行動。
",
      },
      "5",
      4,
    ],
    [
      420,
      Buffer [01 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF FF FF FF 01 00 00 00 00 00 00 00 64 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 3F CD CC CC 3E 00 00 00 00 9A 99 99 3E 01 00 00 00 9A 99 99 3E 01 00 00 00 9A 99 99 3E 01 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 02 00 00 00 01 00 00 00 00 00 80 3F 00 00 80 3F 00 00 80 3F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 70 42 01 00 00 00 01 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 64 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 DC 01 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 00 02 00 00 00 01 00 00 00 01 00 00 00 00 00 80 3F 00 00 80 3F 00 00 80 3F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 00 00 00 B0 07 00 00 70 07 00 00 30 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
