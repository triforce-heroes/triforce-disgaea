    [
      "languages",
      {
        "en": "Omega Ice",
        "es": "Omegafrío",
        "fr": "Oméga-froid",
        "jp": "オメガクール",
        "ko": "오메가 쿨",
        "zh-TW": "終極冰凍",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Summon the guardian of water
to rain down countless shards
of ice across the area.",
        "es": "Invoca al custodio del agua.
Hace llover bloques de hielo
y ataca en un área amplia.",
        "fr": "Invoque le chef de la glace
pour faire pleuvoir des
boules glacées sur la zone.",
        "jp": "水の管理者を召喚する
無数の氷塊を降らせ
広範囲を攻撃する",
        "ko": "물의 관리자를 소환한다.
무수한 얼음덩어리를 퍼부어
넓은 범위를 공격한다.",
        "zh-TW": "召喚水之管理人。
降下無數的冰塊，
來攻擊大範圍的敵人。",
      },
      "5",
      3,
    ],
    [
      420,
      Buffer [01 00 00 00 01 00 00 00 02 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 C3 00 00 00 0F 00 00 00 64 00 00 00 10 0E 00 00 00 00 00 00 01 00 00 00 9A 99 19 3E 9A 99 19 3E 00 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 80 3F 01 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 70 41 00 00 70 41 00 00 A0 40 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 20 41 01 00 00 00 00 01 00 00 00 00 00 20 41 01 00 00 00 01 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 64 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 0E 02 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 02 00 00 00 03 00 00 00 00 00 70 41 00 00 70 41 00 00 A0 40 00 00 00 00 00 00 00 00 00 00 00 00 00 00 40 41 00 00 34 43 00 00 A0 40 35 00 00 00 00 08 00 00 F8 07 00 00 F0 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
