    [
      "languages",
      {
        "en": "Big Bang",
        "es": "Puño Big Bang",
        "fr": "Big bang",
        "jp": "魔拳ビッグバン",
        "ko": "마권 빅뱅",
        "zh-TW": "魔拳爆擊",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Channel the energy of the
entire universe into your
fist, triggering a massive
explosion.",
        "es": "Imbuye tu puño con la energía
del cosmos y provoca una
gran explosión.
",
        "fr": "Concentre l’énergie spatiale
dans les poings pour créer
une énorme explosion.
",
        "jp": "大宇宙のエネルギーを拳に込め
大爆発を引き起こす

",
        "ko": "대우주의 에너지를 주먹에
담아 대폭발을 일으킨다.

",
        "zh-TW": "將全宇宙的能量注入拳頭，
並引發大爆炸。

",
      },
      "5",
      4,
    ],
    [
      420,
