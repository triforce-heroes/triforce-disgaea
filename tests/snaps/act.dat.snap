    ],
    [
      "key",
      "ACT_ID_HERO_AXE_SKILL_3",
    ],
    [
      4,
      Buffer [0A 00 00 00],
    ],
    [
      "notes",
      "スキル・主人公_斧3",
    ],
    [
      "languages",
      {
        "en": "Earthquake Strike",
        "es": "Gran sismo",
        "fr": "Magnitude 11",
        "jp": "大震撃",
        "ko": "대지진 베기",
        "zh-TW": "大震擊",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Strike the ground with the
back of your axe to briefly
stun nearby enemies. Does not
affect flying enemies.",
        "es": "Sacude la tierra con el hacha al
revés y paraliza a los enemigos.
No afecta a enemigos voladores.
",
        "fr": "Fait trembler le sol avec
sa hache pour immobiliser
l’ennemi.
",
        "jp": "逆手に持った斧で大地を震わせ
周囲の敵の動きを止める
飛んでいる敵には当たらない
",
        "ko": "역수로 쥔 도끼로 대지를 울려
주위 적의 움직임을 봉한다.
날고 있는 적은 맞지 않는다.
",
        "zh-TW": "反手拿起斧頭並震動大地，
使周圍的敵人停止行動。
對飛翔的敵人無效。
",
      },
      "5",
      4,
    ],
    [
      420,
      Buffer [01 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF FF FF FF 2C 01 00 00 09 00 00 00 64 00 00 00 C8 AF 00 00 00 00 00 00 00 00 00 00 00 00 00 3F CD CC CC 3E 00 00 00 00 9A 99 99 3E 01 00 00 00 9A 99 99 3E 01 00 00 00 9A 99 99 3E 01 00 00 00 00 00 00 00 00 00 80 3F 00 00 00 00 00 00 00 00 01 00 00 00 00 00 C0 40 0A D7 23 3C 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 70 41 00 00 70 41 CD CC 4C 3E CD CC 4C 3E 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 CD CC 4C 3F 01 00 00 00 00 01 00 00 00 00 00 20 41 01 00 00 00 01 00 00 00 01 00 00 00 01 00 00 00 00 00 00 00 64 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 FF 01 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 00 01 00 00 00 01 00 00 00 03 00 00 00 00 00 70 41 00 00 70 41 CD CC 4C 3E CD CC 4C 3E 00 00 00 00 00 00 00 00 CD CC 4C 3F 00 00 00 00 00 00 00 00 26 00 00 00 C8 07 00 00 88 07 00 00 48 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
