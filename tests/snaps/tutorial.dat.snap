      {
        "en": "Changing N.A.'s Color",
        "es": "Cambiar color de Enea",
        "fr": "La palette de N/A",
        "jp": "エヌエーの色変え",
        "ko": "에누아 색상 전환",
        "zh-TW": "變更艾恩埃的顏色",
      },
      "5",
