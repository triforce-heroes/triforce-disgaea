    [
      "languages",
      {
        "en": "Demodification (Demon Modification)",
        "es": "Tuneado",
        "fr": "La démonification",
        "jp": "魔改造",
        "ko": "마개조",
        "zh-TW": "魔改造",
      },
      "5",
