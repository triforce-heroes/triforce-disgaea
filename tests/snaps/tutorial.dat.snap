    [
      "languages",
      {
        "en": "Movement and Actions",
        "es": "Movimiento y ataque",
        "fr": "Se déplacer et attaquer",
        "jp": "移動と攻撃",
        "ko": "이동과 공격",
        "zh-TW": "移動和攻擊",
      },
      "5",
    ],
    [
      12,
      Buffer [01 00 00 00 A9 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "<cmd CMD_UNIT_MOVE_STICK>　<c t_cmd>Move</c>
<cmd CMD_UNIT_ACTION_ATTACK_1>　<c t_cmd>Normal Attack</c>
<cmd CMD_UNIT_ACTION_ATTACK_2>　<c t_cmd>Strong Attack</c>
<space>
<c t_notice>Move</c> and <c t_notice>attack</c> to defeat the incoming enemies.",
        "es": "<cmd CMD_UNIT_MOVE_STICK> <c t_cmd>Moverse</c>
<cmd CMD_UNIT_ACTION_ATTACK_1> <c t_cmd>Ataque normal</c>
<cmd CMD_UNIT_ACTION_ATTACK_2> <c t_cmd>Ataque fuerte</c>
<space>
<c t_notice>Muevete</c> y <c t_notice>ataca</c> para derrotar a los enemigos.",
        "fr": "<cmd CMD_UNIT_MOVE_STICK> : <c t_cmd>Se déplacer</c>
<cmd CMD_UNIT_ACTION_ATTACK_1> : <c t_cmd>Attaque normale</c>
<cmd CMD_UNIT_ACTION_ATTACK_2> : <c t_cmd>Attaque puissante</c>
<space>
<c t_notice>Déplacez-vous</c> et <c t_notice>attaquez</c> pour vaincre l’ennemi.",
        "jp": "<cmd CMD_UNIT_MOVE_STICK>　<c t_cmd>移動</c>
<cmd CMD_UNIT_ACTION_ATTACK_1>　<c t_cmd>通常攻撃</c>
<cmd CMD_UNIT_ACTION_ATTACK_2>　<c t_cmd>強攻撃</c>
<space>
<c t_notice>移動</c>や<c t_notice>攻撃</c>を駆使して、迫りくる敵を倒しましょう。",
        "ko": "<cmd CMD_UNIT_MOVE_STICK>　<c t_cmd>이동</c>
<cmd CMD_UNIT_ACTION_ATTACK_1>　<c t_cmd>일반 공격</c>
<cmd CMD_UNIT_ACTION_ATTACK_2>　<c t_cmd>강공격</c>
<space>
<c t_notice>이동</c>이나 <c t_notice>공격</c>을 해서 다가오는 적을 쓰러뜨리세요.",
        "zh-TW": "<cmd CMD_UNIT_MOVE_STICK>　<c t_cmd>移動</c>
<cmd CMD_UNIT_ACTION_ATTACK_1>　<c t_cmd>一般攻擊</c>
<cmd CMD_UNIT_ACTION_ATTACK_2>　<c t_cmd>強攻擊</c>
<space>
善用<c t_notice>移動</c>和<c t_notice>攻擊</c>，打倒襲來的敵人吧。",
      },
      "6.0",
      5,
    ],
