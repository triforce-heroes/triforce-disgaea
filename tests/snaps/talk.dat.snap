    ],
    [
      "dialog",
      {
        "en": "Guess you don't know everything, then...",
        "es": "Así que hay cosas que ni tú sabes.",
        "fr": "Il y a donc des choses que tu ignores.",
        "jp": "お前でも知らないことはあるんだな。",
        "ko": "너도 모르는 게 있긴 하군.",
        "zh-TW": "你也有不知道的事啊。",
      },
      "4.3",
