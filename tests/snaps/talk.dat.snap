    [
      140,
      Buffer [00 00 00 00 00 00 00 00 04 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 4D 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "Apparently there's a bunch of dark matter drifting
through space. There's a theory it might be edible... I
think I won't be testing that, though.",
        "es": "La materia oscura que flota por el espacio...
Dicen que quizá hasta se pueda comer, pero...
Uff, yo paso.",
        "fr": "La matière noire en suspension dans l’espace.
Une théorie prétend qu’elle serait comestible...
J’attends de voir.",
        "jp": "宇宙にたゆたう暗黒物質ダークマター。
一説によると食用にもできるらしいが……。
うーむ、我は遠慮しておきたいな。",
        "ko": "우주를 떠도는 암흑 물질 다크 매터.
일설에 따르면 식용으로도 쓸 수 있다는데…
으~음, 나는 사양하고 싶어.",
        "zh-TW": "在宇宙中漂浮著的黑暗成分「暗物質」。
似乎有說法稱可以食用……
唔，但我還是敬謝不敏啊。",
      },
      "4.1",
      3,
      [
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
