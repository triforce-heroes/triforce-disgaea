    ],
    [
      "key",
      "TALK_ID_3011_001_58",
    ],
    [
      140,
      Buffer [00 00 00 00 00 00 00 00 04 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 4D 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "Insect repellent is a must when swimming in the
Intoxicated Forest. Unless you want to get stung all
over and be miserably itchy, that is.",
        "es": "Si vas a nadar en el Bosque inundado, el repelente de
insectos es obligatorio. Si no, acabarás con picaduras por
todas partes y te rascarás como si no hubiera un mañana.",
        "fr": "Badigeonne-toi d’insecticide si
tu visites le Bosquet Ploufplouf.
Ou tu finiras recouvert de piqûres.",
        "jp": "酔没林で泳ぐときは、虫よけスプレーは必須だ。
あちこち虫に刺されて、むずかゆい思いを
する羽目になるぞ。",
        "ko": "취기에 잠긴 숲에서 헤엄칠 땐 벌레 기피제가
필수야. 안 그랬다간 여기저기 벌레에 쏘여서
근질근질 가렵거든.",
        "zh-TW": "在醉沒林游泳時，一定要噴防蚊噴霧。
不然就會被蟲叮得滿身包，
整個人癢到抓狂。",
      },
      "4.1",
      3,
      [
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
      ],
    ],
    [
