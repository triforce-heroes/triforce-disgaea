    [
      140,
      Buffer [00 00 00 00 00 00 00 00 04 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 4D 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "Some mercenary groups kidnap orphaned demon kids and
train them as new members. I know we're all demons, but
even so, that's crossing the line.",
        "es": "Y dentro de esas organizaciones, hay quien secuestra a
niños demonio sin familia y los convierte en mercenarios.
Hasta para un demonio, hay cosas que no se hacen.",
        "fr": "Certaines iraient même jusqu’à enlever des enfants
démons isolés pour en faire des mercenaires.
Démon ou pas, certains actes restent impardonnables.",
        "jp": "傭兵組織の中には、身寄りのない悪魔の子どもを
さらってきて傭兵に仕立て上げるのもいるという。
いかに悪魔とはいえ許されざることはあるのだぞ。",
        "ko": "용병 조직 중에는 갈 곳 없는 악마 녀석들을
납치해 와서 용병으로 키우는 곳도 있다고 해.
아무리 악마여도 그런 몹쓸 짓까지 하다니.",
        "zh-TW": "據說一些傭兵組織甚至會擄走孤身無依的
惡魔孩童，把他們訓練成傭兵。
就算是惡魔，也是有不能跨越的底線的。",
      },
      "4.1",
      3,
      [
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
      ],
