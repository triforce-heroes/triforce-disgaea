    [
      128,
      Buffer [05 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "Really? Then do you wanna come with me to the Carnage
Dimension?",
        "es": "¿Quieres ir? ¿A la dimensión shura?",
        "fr": "Tu comptes t’y rendre ?",
        "jp": "そうか、なら行ってみるか？
