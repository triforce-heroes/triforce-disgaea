    [
      "key",
      "TALK_ID_3011_001_61",
    ],
    [
      140,
      Buffer [00 00 00 00 00 00 00 00 04 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 4D 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "Fried rice cooked over the fires of Mt. Calamity is
scrumptious! Give it a taste, you'll see. It'll blow
your mind.",
        "es": "¡El arroz frito hecho con las llamas del Volcán calamitoso
está de vicio! Pruébalo alguna vez.
Te volará la cabeza.",
        "fr": "Les steaks grillés aux flammes du Mont Furax
sont un vrai régal !
À goûter au moins une fois dans sa vie.",
        "jp": "禍火山の炎で作ったチャーハンは絶品！
試しに一度、食ってみろ。
飛ぶぞ。",
        "ko": "화화산 불꽃으로 만든 볶음밥은 최고야!
기회가 되면 꼭 한번 먹어 봐.
날아갈 거야.",
        "zh-TW": "用禍火山的火焰炒出來的炒飯超好吃！
找機會試試看吧。
好吃到會升天喔。",
      },
