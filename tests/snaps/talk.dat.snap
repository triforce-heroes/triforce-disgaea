    [
      140,
      Buffer [00 00 00 00 00 00 00 00 04 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00 01 00 00 00 00 00 00 00 00 4D 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
    [
      "dialog",
      {
        "en": "There was once a violent war in Pestilence Plains. All
the damage from it hasn't been fixed yet because John-
Zuck has been slacking off.",
        "es": "En Llanura infectada antes habían combates brutales..
Si aún quedan partes sin reparar es porque
John Huck se escaquea del curro.",
        "fr": "La Plaine Kraspec était déchirée par les batailles
il fut un temps. Et c’est la faute de Rondinou
si les cicatrices perdurent.",
        "jp": "病原も昔は激しい戦闘があった。
傷跡がまだ修復されていないのは、
ジョンハックが仕事をサボっているからだ。",
        "ko": "질병의 들판도 옛날에 큰 전투가 있었지.
상흔이 아직 남아 있는 건
존핵이 일을 안 하고 놀아서 그래.",
        "zh-TW": "病原過去也發生過激烈的戰鬥。
留下的傷痕之所以至今仍未修復，
是因為喬哈克偷懶沒做事。",
      },
      "4.1",
      3,
      [
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
        Buffer [00 00 00 00],
      ],
