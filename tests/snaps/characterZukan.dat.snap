    [
      76,
      Buffer [00 00 00 00 00 00 00 00 02 00 00 00 78 C3 00 00 99 75 00 00 00 00 00 00 01 00 00 00 FE 23 00 00 03 00 00 00 F8 9F A8 00 78 C3 00 00 E0 A3 A8 00 79 C3 00 00 C8 A7 A8 00 7A C3 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
