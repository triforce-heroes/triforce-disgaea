    [
      "key",
      "図鑑_死姫族",
    ],
    [
      4,
      Buffer [20 A0 F8 05],
    ],
    [
      "languages",
      {
        "en": "Zombie Maidens",
        "es": "Facción princesa zombi",
        "fr": "Jiangshis",
        "jp": "死姫族",
        "ko": "사희족",
        "zh-TW": "死姬族",
      },
      "3",
    ],
    [
      "dialog",
      {
        "en": "Resurrected from death through rituals
performed on their corpses, Zombie
Maidens have somewhat childlike
demeanors and low intellect. Most have
no memories of when they were alive.
",
        "es": "Demonios que reviven cuando aplican
un ritual a un cadáver. Tienen poca
inteligencia y un aire infantil. Muchos
no conservan recuerdos de cuando
estaban vivos.
",
        "fr": "Des démones ressuscitées grâce à
un sortilège jeté sur leurs cadavres.
Leurs capacités cognitives sont
semblables à celles d’un enfant.
La plupart des spécimens n’ont aucun
souvenir de leur vie antérieure.",
        "jp": "死体に術式が施されて蘇った悪魔。
知性は控えめで、子どものよう。
生前の記憶は、残っていない者が多い。


",
        "ko": "시체에 사용한 술식 때문에 되살아난 악마.
지성이 부족하며 아이처럼 행동한다.
대부분 생전의 기억을 가지고 있지 않다.


",
        "zh-TW": "對屍體施展術式後復活的惡魔。
知識較淺薄，宛如孩童一般。
大多數都已不具有生前的記憶。


",
      },
      "4",
      6,
    ],
    [
      76,
      Buffer [00 00 00 00 00 00 00 00 02 00 00 00 FA C3 00 00 99 75 00 00 00 00 00 00 01 00 00 00 0C 24 00 00 03 00 00 00 08 A4 F8 05 FA C3 00 00 F0 A7 F8 05 FB C3 00 00 D8 AB F8 05 FC C3 00 00 6E 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
