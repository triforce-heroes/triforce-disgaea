    ],
    [
      4,
      Buffer [30 C7 F8 05],
    ],
    [
      "languages",
      {
        "en": "Flora Beasts",
        "es": "Facción flor embaucadora",
        "fr": "Flauras sauvages",
        "jp": "妖花族",
        "ko": "요화족",
        "zh-TW": "妖花族",
      },
      "3",
    ],
    [
      "dialog",
      {
        "en": "One-of-a-kind floral beauties who seek
to monopolize the attention they receive
from others on account of their
bewitching good looks and charm.",
        "es": "Una única flor demoníaca que floreció
en el inframundo. Con su belleza y su
fragancia, quiere que la atención sea
solo para ella.",
        "fr": "Des fleurs démoniaques poussant
dans les Sous-mondes.
Cherchent à attirer toute l’attention
de par leur beauté et leur parfum.",
        "jp": "魔界に咲いた一輪の妖花。
その麗しさと香しさとで、
周囲の注目を自分だけのものに
したがっている。",
        "ko": "마계에 핀 한 송이의 요화.
미모와 향기로
주변의 이목이 자신에게만
집중되기를 원한다.",
        "zh-TW": "綻放於魔界中的一朵妖花。
利用自身的艷麗外表與香氣，
使周圍的所有目光
都只投向自己。",
      },
      "4",
      4,
    ],
    [
      76,
      Buffer [00 00 00 00 00 00 00 00 02 00 00 00 04 C4 00 00 99 75 00 00 00 00 00 00 01 00 00 00 0D 24 00 00 03 00 00 00 18 CB F8 05 04 C4 00 00 00 CF F8 05 05 C4 00 00 E8 D2 F8 05 06 C4 00 00 6E 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
