    [
      "key",
      "図鑑_呪眼族",
    ],
    [
      4,
      Buffer [50 15 F9 05],
    ],
    [
      "languages",
      {
        "en": "Evil Eyes",
        "es": "Facción mal de ojo",
        "fr": "Catoblépas",
        "jp": "呪眼族",
        "ko": "주안족",
        "zh-TW": "咒眼族",
      },
      "3",
    ],
    [
      "dialog",
      {
        "en": "Bovine demons who—despite their shy
nature—possess tremendous latent power
and cursed eyes in both hands. Be
mindful of their charge attacks.

",
        "es": "Monstruos bovinos con ojos malditos
en ambas manos. Por lo general son
cobardes, pero el poder que esconden
es extremadamente potente. Torea bien
sus embestidas.
",
        "fr": "Des monstres bovidés dotés
d’un œil maudit dans chaque main.
Peureuses de nature, elles renferment
néanmoins une force cachée
extraordinaire.
Évitez de porter du rouge.",
        "jp": "両手に呪眼を宿した牛系魔物。
基本的に臆病だが、
その秘めたるパワーは超強力。
突進攻撃に注意。

",
        "ko": "양손에 주안이 깃든 소 마물.
평소에는 겁이 많지만
굉장한 힘을 숨기고 있다.
돌진 공격에 주의하자.

",
        "zh-TW": "雙手寄宿著咒眼的牛系魔物。
生性膽小，
但蘊藏其中的威力極為強大。
要小心突進攻擊。

",
      },
      "4",
      6,
    ],
    [
      76,
      Buffer [00 00 00 00 00 00 00 00 02 00 00 00 0E C4 00 00 99 75 00 00 00 00 00 00 01 00 00 00 0F 24 00 00 03 00 00 00 38 19 F9 05 0E C4 00 00 20 1D F9 05 0F C4 00 00 08 21 F9 05 10 C4 00 00 6E 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
