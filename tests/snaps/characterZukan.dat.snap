      4,
      Buffer [1C 00 00 00],
    ],
    [
      "key",
      "図鑑_煽板族",
    ],
    [
      4,
      Buffer [50 C3 71 02],
    ],
    [
      "languages",
      {
        "en": "Signpost Demons",
        "es": "Facción tablón",
        "fr": "Vadémécums",
        "jp": "煽板族",
        "ko": "선판족",
        "zh-TW": "煽板族",
      },
      "3",
    ],
    [
      "dialog",
      {
        "en": "Always holding up a sign for reasons
unknown. Most cannot decide for
themselves whether they're cute or
annoying. Ostensibly, their job in the
Super Duper Netherworld is to serve as
guides, but this, too, is unclear.",
        "es": "Por algún motivo, siempre van con un
cartel en la mano. No sabes si son
adorables... o dan tirria. En Megamejor,
su trabajo principal parece ser guiar
y dar indicaciones de cosas.
",
        "fr": "Portent constamment une pancarte
sur eux. Difficile de dire s’ils sont
adorables ou détestables.
Ils travaillent essentiellement comme
guides dans le Sous-monde Suprême.
",
        "jp": "なぜか常に看板を持ってるヤツ。
かわいいんだか、憎らしいんだか。
傑超魔界ではもっぱら、なにかを案内をする
のが主な仕事のようだ。

",
        "ko": "어째선지 항상 간판을 들고 있는 녀석.
귀엽다고 해야 할지, 얄밉다고 해야 할지.
걸초마계에서는 대부분 무언가에 대해
안내하는 것이 주된 일인 모양이다.

",
        "zh-TW": "不知為何總是拿著告示牌的傢伙。
感覺有點可愛又有點欠揍。
在傑超魔界裡的主要工作
似乎都是在幫忙指引什麼地點。

",
      },
      "4",
      6,
    ],
    [
      52,
      Buffer [00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 0A 24 00 00 01 00 00 00 50 C3 71 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00],
    ],
  ],
  [
