    [
      "languages",
      {
        "en": "Use Boost Tickets",
        "es": "Usar tickets de aumento",
        "fr": "Utilisation de tickets Boost",
        "jp": "ブーストチケット使用",
        "ko": "부스트 티켓 사용",
