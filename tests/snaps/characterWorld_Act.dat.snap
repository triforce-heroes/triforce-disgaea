      },
      "5",
      1,
    ],
    [
      "dialog",
      {
        "en": "Battle Buddy HP recovered!",
        "es": "¡Los PV de los familiares se han recuperado!",
        "fr": "PV des familiers restaurés !",
        "jp": "従魔のＨＰが回復した！",
        "ko": "사역마의 HP가 회복됐다!",
        "zh-TW": "使魔的HP已恢復！",
      },
      "6",
      1,
    ],
    [
      "languages",
      {
        "en": "No Battle Buddies in need of healing!",
