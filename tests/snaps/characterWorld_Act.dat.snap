    [
      "languages",
      {
        "en": "I'll Cheer You On!",
        "es": "¡Te apoyo!",
        "fr": "En soutien !",
        "jp": "応援する！",
        "ko": "응원한다!",
        "zh-TW": "加油打氣！",
      },
      "4",
    ],
    [
      "dialog",
      {
        "en": "Restore Battle Buddy's HP by 30%.",
        "es": "Recupera un 30 % de los PV de los familiares.",
        "fr": "Restaure les PV des familiers de 30 %.",
        "jp": "従魔のＨＰを３０％回復させる",
        "ko": "사역마의 HP를 30％ 회복합니다.",
